__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/
*.tmp
results/MG003/ew*.log
results/MG003b/*.log
results/MG003c/*.log
results/MG004/*.log
# results/MG2/cells/ is committed (small; protects compute against container loss)
results/MG2/stdout.txt
results/MG3/partial/

# MG5: event lists and full fields stay on the PI's PC (SHA-256 manifest in results/MG5/local_manifest.csv)
results/MG5/local/
# MG6: candidate lists and full fields stay on the PI's PC (SHA-256 manifest in results/MG6/local_manifest.csv)
results/MG6/local/
# MG6 Part 0: final states used by the quadrature check stay local
results/MG6/part0/final_*.npz
# MG7: candidate lists and full fields stay on the PI's PC (SHA-256 manifest in results/MG7/local_manifest.csv)
results/MG7/local/
results/MG7/superseded/
# MG7 Part 0: settled unregistered states stay local (SHA-256 in decisions.json)
results/MG7/part0/settled_*.npz
# MG4 Part A full fields stay on the PI's PC
results/MG4/partA/fields/
# MG9: per-state .npy files are bundled into results/MG9/states.npz (committed)
results/MG9/states/
# MG9c: per-snapshot .npy files are bundled into results/MG9c/snapshots.npz (committed)
results/MG9c/snapshots/
results/MG9d/snapshots/
# MG9b: run checkpoints and per-run confirmation fields stay local (the V-b2 sample is committed as vb2_*_fields.npz)
results/MG9b/partial/
results/MG9b/fields/
# MG8: full stochastic fields stay on the PI's PC (SHA-256 in each run record)
results/MG8/full/

# PI instruction: large MG160 raw data are retained in the local archive checkout.
/results/MG12H3/pattern_persistence/P1_production/
/results/MG12H3/pattern_persistence/P1_exploratory_mean_fields.npz

# Preferred ignored location for future local-only raw archives.
/local_raw/

# MG163 uncompressed local decision export; public lossless gzip replaces it
/results/MG12H3/long_horizon_persistence/fresh_candidate_scores.json

# Public diagnostic JSON uses null for undefined variance ratios
/results/MG12H3/species_profile_diagnostic/diagnostics.json

# MG165 full decision JSON stays local; compact v2 gzip exports are public
/results/MG12H3/multivariate_instrument/*_fits.json
/results/MG12H3/multivariate_instrument/*_candidate.json
/results/MG12H3/multivariate_instrument/r*_calibration.json
/results/MG12H3/multivariate_instrument/benchmark.json
/results/MG12H3/multivariate_instrument/analysis.json
/results/MG12H3/multivariate_instrument/v2/*_fits.json
/results/MG12H3/multivariate_instrument/v2/*_candidate.json

# MG167 public lossless decision exports are gzip-compressed
/results/MG12H3/XY_core_instrument/*_fits.json

# MG168 per-field oracle decisions are public as lossless gzip
/results/MG12H3/known_geometry_XY/r[012]_*.json
